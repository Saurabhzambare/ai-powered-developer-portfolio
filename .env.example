# ============================================================
# AI-Powered Developer Portfolio
# Environment Configuration Template
# ============================================================
#
# SAFE TEMPLATE ONLY.
#
# Copy required values into a local .env file when the
# corresponding application/service is implemented.
#
# NEVER place real passwords, API keys, access tokens,
# private keys, or production secrets in this file.
#
# IMPORTANT:
# Variables beginning with VITE_ may be exposed to the browser.
# Never store secrets in a VITE_ variable.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
#
# PostgreSQL is the approved database.
# The exact local/deployment connection value will be configured
# when the database layer is implemented.
#
# Example format:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE_NAME

DATABASE_URL=


# ------------------------------------------------------------
# CORS / frontend origin
# ------------------------------------------------------------

CORS_ORIGINS=http://localhost:5173


# ------------------------------------------------------------
# AI / LLM configuration
# ------------------------------------------------------------
#
# Provider and model selection are intentionally deferred.
# Do not interpret these variables as a provider decision.

AI_PROVIDER=
AI_MODEL=
AI_API_KEY=


# ------------------------------------------------------------
# Embeddings
# ------------------------------------------------------------
#
# Embedding provider/model selection is intentionally deferred.

EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=


# ------------------------------------------------------------
# GitHub integration
# ------------------------------------------------------------
#
# Optional authenticated GitHub access may be added later.
# Leave blank unless the backend requires it.

GITHUB_TOKEN=


# ------------------------------------------------------------
# Frontend — PUBLIC browser configuration only
# ------------------------------------------------------------
#
# WARNING:
# Every VITE_ variable must be treated as public information.

VITE_API_BASE_URL=http://localhost:8000
VITE_APP_ENV=development